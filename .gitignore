# ---- 依赖与构建产物 -------------------------------------------------------
node_modules/
.pytest_cache/
__pycache__/
*.py[cod]

# Android / Capacitor：这些都由 `npm run sync` 和 gradle 重新生成
app-shell/android/build/
app-shell/android/app/build/
app-shell/android/.gradle/
app-shell/android/local.properties
# sync-web.mjs 会把 ../web 和 ../backend/app 复制到这里；提交它们等于维护两份
app-shell/www/
app-shell/android/app/src/main/assets/public/
app-shell/android/app/src/main/assets/capacitor.config.json
app-shell/android/app/src/main/assets/capacitor.plugins.json
app-shell/android/app/src/main/python/app/
app-shell/android/app/src/main/python/kb/
app-shell/android/capacitor-cordova-android-plugins/
app-shell/android/app/src/main/assets/capacitor-cordova-android-plugins/

# ---- 运行期数据 -----------------------------------------------------------
# 本地 SQLite：包含本机跑测试留下的账号与对话。空库在首次启动时自动建表+种子，
# 所以不入库不影响别人跑起来。
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal

# ---- 测试产物 -------------------------------------------------------------
e2e/report.json
e2e/device-report.json
*.log

# ---- 编辑器与系统 ---------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db